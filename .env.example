# Copy to .env for docker run --env-file .env.
TODO_PORT=7540
# Leave empty to disable authentication.
TODO_PASSWORD=
# Required with TODO_PASSWORD; generate with: openssl rand -hex 32
TODO_JWT_SECRET=
# Optional comma-separated origins, e.g. http://localhost:3000
# TODO_CORS_ORIGINS=http://localhost:7540,http://127.0.0.1:7540
TZ=Europe/Moscow
